<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifesto do pacote MSIX do MeshDeck para a Microsoft Store.
  A versão (__VERSAO__) é preenchida pelo GitHub Actions a partir da tag do Release (v1.6 -> 1.6.0.0).
  Os dados de Identity vêm do Partner Center (Identidade do Produto) e não devem ser alterados.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="00Aleh00.MeshDeck3DViewer"
    Publisher="CN=A1A89383-6843-4667-998C-DEF86CD611E0"
    Version="__VERSAO__"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>MeshDeck 3D Viewer</DisplayName>
    <PublisherDisplayName>00Aleh00</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <!-- cada idioma aqui exige uma página da loja nesse idioma no Partner Center -->
    <Resource Language="en-us" />
    <Resource Language="pt-br" />
  </Resources>

  <Applications>
    <Application Id="MeshDeck"
      Executable="MeshDeck\MeshDeck.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="MeshDeck 3D Viewer"
        Description="3D model viewer and library for 3D printing (STL, 3MF, OBJ, PLY, ZIP)"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="modelo3d">
            <uap:DisplayName>3D model</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.stl</uap:FileType>
              <uap:FileType>.3mf</uap:FileType>
              <uap:FileType>.obj</uap:FileType>
              <uap:FileType>.ply</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
